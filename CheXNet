ll.execute_reply.started":"2026-06-06T23:26:55.116647Z","shell.execute_reply":"2026-06-06T23:26:55.128637Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"for epoch in range(BaseConfig.EPOCHS):\n    \n    best_val_loss = float('inf')\n    save_path = 'best_chexnet_model.pt'  #가장 낮은 val_loss를 기록한 모델을 저장\n\n    \n    #모델 훈련\n    model.train()\n    train_loss=0.0\n\n    for images, labels in tqdm(train_dataloader):\n        images=images.to(device)\n        labels=labels.to(device)\n\n        output=model(images)\n        loss=criterion(output, labels)\n\n        optimizer.zero_grad()\n        loss.backward()\n        optimizer.step()\n\n        train_loss+=loss.item()\n\n    train_loss=train_loss/len(train_dataloader)\n    print(f'Epoch: {epoch+1:4d}  |  Train Loss: {train_loss:.4f}')\n\n    model.eval()\n    val_loss=0.0\n\n    with torch.no_grad():\n        for images, labels in valid_dataloader:\n            images=images.to(device)\n            labels=labels.to(device)\n\n            output=model(images)\n            loss=criterion(output, labels)\n\n            val_loss+=loss.item()*images.shape[0]   \n            #val_loss를 구할때, tran loss 구하는 것처럼 하면 drop last가 false라서 마지막 배치 사이즈가 작아도 손실값은 가중치가 똑같이 계산됨.\n\n    val_loss=val_loss/len(valid_dataloader.dataset)  #따라서 1장당 loss에 배치 사이즈 곱해주고, 전체 데이터로 나눔.\n\n\n    scheduler.step(val_loss)\n    current_lr = optimizer.param_groups[0]['lr']  #lr 변화확인\n    print(f'Validation Loss: {val_loss:.4f}, Learning Rate: {current_lr:.6f}')\n\n\n    if val_loss<best_val_loss:\n        print('가장 낮은 val_loss 기록, 모델 저장')\n\n        best_val_loss=val_loss\n\n        torch.save(model.state_dict(), save_path)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T08:11:35.356217Z","iopub.execute_input":"2026-06-06T08:11:35.357041Z","iopub.status.idle":"2026-06-06T09:31:29.815681Z","shell.execute_reply.started":"2026-06-06T08:11:35.356998Z","shell.execute_reply":"2026-06-06T09:31:29.814597Z"}},"outputs"