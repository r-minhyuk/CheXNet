\n\nclass CheXNetData(Dataset):\n    def __init__(self, df, transform=None):\n        self.df=df\n        self.transform=transform\n\n    def __getitem__(self, idx):\n        image=Image.open(self.df['path'].values[idx]).convert('RGB')\n        labels=self.df.iloc[:,4:].values[idx]\n\n        if self.transform:\n            transformed_img=self.transform(image=np.array(image))\n            image=transformed_img['image']\n\n        label=torch.tensor(labels, dtype=torch.float)   #BCE는 정수가 아닌 실수 텐서 입력값을 라벨로 받는다.\n\n        return image, label\n\n    def __len__(self):\n        return len(self.df)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.168305Z","iopub.execute_input":"2026-06-06T07:17:51.168696Z","iopub.status.idle":"2026-06-06T07:17:51.175821Z","shell.execute_reply.started":"2026-06-06T07:17:51.168651Z","shell.execute_reply":"2026-06-06T07:17:51.175136Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#훈련 데이터용 transform\nimport albumentations as A\nfrom albumentations.pytorch import ToTensorV2\n\ntransform_train=A.Compose([\n    A.Resize(224,224),    #224*224로 downsize\n    A.HorizontalFlip(p=0.5),   #논문에서 구현한 random horizontal flipping, 폐는 양쪽 모두 있기에 사용가능\n    A.Normalize(),  #imagenet mean/std로 정규화\n    ToTensorV2()\n])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.176766Z","iopub.execute_input":"2026-06-06T07:17:51.177358Z","iopub.status.idle":"2026-06-06T07:17:51.190283Z","shell.execute_reply.started":"2026-06-06T07:17:51.177326Z","shell.execute_reply":"2026-06-06T07:17:51.189652Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#valid, test data용 transform\ntransform_test=A.Compose([\n    A.Resize(224,224),\n    A.Normalize(),\n    ToTensorV2()\n])","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.19127Z","iopub.execute_input":"2026-06-06T07:17:51.191553Z","iopub.status.idle":"2026-06-06T07:17:51.20573Z","shell.execute_reply.started":"2026-06-06T07:17:51.191531Z","shell.execute_reply":"2026-06-06T07:17:51.205044Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## DataSet train, valid, test로 나누기","metadata":{}},{"cell_type":"code","source":"df_train_val=pd.merge(all_xray_df, df_train_val_list, on='Image Index', how='inner')\ndf_test=pd.merge(all_xray_df, df_test_list, on='Image Index', how='inner')\n\nfrom sklearn.model_selection import train_test_split\n\n#논문에서 언급한대로 patient overlap이 없도록 train_val 분리하기\nunique_train_val_patients=df_train_val['Patient ID'].unique()\n\ntrain_patients, valid_patients=train_test_split(unique_train_val_patients, test_size=0.08, random_state=42)   #최대한 논문에서 제시한 크기에 알맞게 나눔\n\ndf_train=df_train_val[df_train_val['Patient ID'].isin(train_patients)].reset_index(drop=True)\ndf_valid=df_train_val[df_train_val['Patient ID'].isin(valid_patients)].reset_index(drop=True)\ndf_test=df_test.reset_index(drop=True)\n\nprint(f'훈련 데이터: {len(df_train)}장, 환자: {len(train_patients)}명\\n검증데이터: {len(df_valid)}장, 환자: {len(valid_patients)}명\\n테스트 데이터: {len(df_test)}장')","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.207799Z","iopub.execute_input":"2026-06-06T07:17:51.208126Z","iopub.status.idle":"2026-06-06T07:17:51.367256Z","shell.execute_reply.started":"2026-06-06T07:17:51.208104Z","shell.execute_reply":"2026-06-06T07:17:51.36653Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#증강, 모델 구조의 성능을 순수하게 확인하기 위한 코드\n\n\n#멀티 프로세싱을 위한 시드 고정\nimport random\n\n#전역 시드 고정\ndef set_seed(seed=42):\n    random.seed(seed)    #파이선 기본 내장 random 모듈 시드\n    np.random.seed(seed)    #numpy 랜덤 시드, albumentation가 numpy랜덤 모듈을 사용\n    torch.manual_seed(seed)    #CPU에서 동작하는 pytorch 랜덤 시드(모델 가중치 초기화 등)\n    torch.cuda.manual_seed(seed)       # 단일 GPU용\n    torch.cuda.manual_seed_all(seed)    #멀티 GPU에서 동작하는 pytorch 랜덤 시드(dropout 등)\n\n\n#worker init fn(서브 프로세스 시드 고정)\ndef seed_worker(worker_id):\n    worker_seed = torch.initial_seed() % 2**32\n    np.random.seed(worker_seed)\n    random.seed(worker_seed)\n\nset_seed()\ng = torch.Generator()  # 제너레이터 생성\ng.manual_seed(0)  # 제너레이터 시드값 고정\n#전역 시드 고정해도 프로세스들의 순서가 달라지면 학습되는 데이터 순서가 달라질 수 있으므로 shuffle을 통제","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.368081Z","iopub.execute_input":"2026-06-06T07:17:51.368428Z","iopub.status.idle":"2026-06-06T07:17:51.375873Z","shell.execute_reply.started":"2026-06-06T07:17:51.368391Z","shell.execute_reply":"2026-06-06T07:17:51.375204Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"#dataset 생성\ntrain_dataset=CheXNetData(df_train, transform=transform_train)\nvalid_dataset=CheXNetData(df_valid, transform=transform_test)\ntest_dataset=CheXNetData(df_test, transform=transform_test)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.376952Z","iopub.execute_input":"2026-06-06T07:17:51.377294Z","iopub.status.idle":"2026-06-06T07:17:51.389409Z","shell.execute_reply.started":"2026-06-06T07:17:51.37727Z","shell.execute_reply":"2026-06-06T07:17:51.388659Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"from torch.utils.data import DataLoader\n\ntrain_dataloader=DataLoader(train_dataset, batch_size=BaseConfig.BATCH_SIZE, worker_init_fn=seed_worker, shuffle=True, generator=g, num_workers=2)\nvalid_dataloader=DataLoader(valid_dataset, batch_size=BaseConfig.BATCH_SIZE, worker_init_fn=seed_worker, shuffle=True, generator=g, num_workers=2,\n                           drop_last=False)  #default도 false이다. valid랑 test는 모든 데이터 대상으로 적용되야 하기 때문에 False.\ntest_dataloader=DataLoader(test_dataset, batch_size=BaseConfig.BATCH_SIZE, worker_init_fn=seed_worker, shuffle=True, generator=g, num_workers=2,\n                          drop_last=False)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-06-06T07:17:51.390345Z","iopub.execute_input":"2026-06-06T07:17:51.390662Z","iopub.status.idle":"2026-06-06T07:17: